#!/usr/bin/env bash
set -eo pipefail

# ==============================================================================
# Legacy entry point — Phase 3 / M3.4 起为统一 pipeline 的兼容 wrapper。
# 评估/聚合/报告逻辑已迁移到 scripts/evaluation/run_pipeline.py
# （v2 评估核心 + vep.aggregate.v2 聚合 + generate_report_v2 报告）。
# 本脚本按 manifest 检查并标准化 SARIF，再交给统一评估入口。
# ==============================================================================

echo "========================================="

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$PROJECT_ROOT"

if [ -f ".venv/bin/activate" ]; then
    source .venv/bin/activate
fi
PYTHON="${PYTHON:-python3}"
echo "   CodeQL Evaluation Framework"
echo "========================================="

if [ ! -d "experiments" ]; then
    echo "❌ experiments/ directory not found."
    exit 1
fi

echo "[+] Checking and normalizing SARIF files..."
"$PYTHON" - <<'PY'
import os
import sys
import tempfile
from pathlib import Path

from vep.core.manifest import load_manifest
from vep.evaluation.sarif import load_sarif_findings, write_findings_csv

try:
    entries = load_manifest(project_root=Path.cwd()).resolve(["all"])
    if not entries:
        raise ValueError("Manifest contains no CWE entries")
    inputs = []
    for entry in entries:
        if entry.experiments_directory is None:
            raise ValueError(f"{entry.name}: missing experiments.directory")
        directory = entry.experiments_directory / "results/codeql"
        source = directory / f"cwe{entry.id}.sarif"
        if not source.is_file():
            raise FileNotFoundError(f"Missing SARIF: {source}")
        inputs.append((entry, source, directory / f"cwe{entry.id}.csv"))
    for entry, source, destination in inputs:
        findings = load_sarif_findings(source, tool="codeql", cwe=entry.name)
        with tempfile.TemporaryDirectory(prefix=".vep-sarif-", dir=destination.parent) as temp:
            staged = Path(temp) / destination.name
            write_findings_csv(findings, staged)
            os.replace(staged, destination)
        print(f"[+] {entry.name}: normalized {len(findings)} findings")
except (OSError, ValueError, TypeError, AttributeError) as exc:
    print(f"SARIF normalization failed: {exc}", file=sys.stderr)
    sys.exit(1)
PY

echo "[+] Delegating to unified pipeline (evaluate, aggregate, report)..."
"$PYTHON" scripts/evaluation/run_pipeline.py \
    --tool codeql \
    --cwe all \
    --stages evaluate,aggregate,report \
    --no-skip-existing

echo ""
echo "========================================="
echo "   Evaluation Completed Successfully"
echo "========================================="
echo ""
echo "Reports generated in reports/"
echo "Open reports/report.md to view results."
